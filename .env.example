# Copy to .env for local dev. Never commit .env (.env* is gitignored).

# --- Database (required) ---------------------------------------------------
# Local Docker Postgres (docker compose up), or any Postgres URL.
DATABASE_URL=postgresql://ecom:ecom_dev_password@localhost:5433/ecom_inv

# --- Cloudflare R2 (product images & files) --------------------------------
# S3-compatible object storage. Server-side only — never prefix with
# NEXT_PUBLIC_. Uploads proxy through the API; reads stream through an
# auth-gated route (GET /api/attachments/[id]/raw), so the bucket stays private.
# Image/file upload degrades gracefully (disabled) if these are unset.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=ecommerce-inventory
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key

# --- Seed admin (used only by npm run db:seed) -----------------------------
# The first administrator account. Change the password after first login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now-123
# Optional: set to also seed demo cashier / stock-clerk accounts with this password.
SEED_DEMO_PASSWORD=

# --- Not required (kept here so nobody re-adds them) ------------------------
# NODE_ENV       — set by next build / next start / the host. Don't set it manually.
# SESSION_SECRET — not used. Sessions are opaque random tokens (randomBytes(32));
#                  only a SHA-256 hash is stored, so there is nothing to sign.
